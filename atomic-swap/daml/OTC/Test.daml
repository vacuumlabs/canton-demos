module OTC.Test where

import DA.Date
import DA.Time

import Daml.Script
import OTC.Model
import OTC.DemoToken

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1

demoTime : Time
demoTime = time (date 2026 Jul 20) 12 0 0

allocationDeadline : Time
allocationDeadline = addRelTime demoTime (days 1)

settlementDeadline : Time
settlementDeadline = addRelTime demoTime (days 2)

emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

balance : Party -> InstrumentId -> Script Decimal
balance owner instrumentId = do
  holdings <- queryInterface @Holding owner
  pure $ sum do
    (_, Some holding) <- holdings
    guard (holding.owner == owner && holding.instrumentId == instrumentId)
    pure holding.amount

allocateLeg
  : Party
  -> Party
  -> ContractId DemoTokenRules
  -> AllocationSpecification
  -> [ContractId Holding]
  -> Script (ContractId Allocation)
allocateLeg sender admin rulesCid allocation inputHoldingCids = do
  Some rulesDisclosure <- queryDisclosure @DemoTokenRules admin rulesCid
  result <- submitWithDisclosures sender [rulesDisclosure] do
    exerciseCmd (toInterfaceContractId @AllocationFactory rulesCid) AllocationFactory_Allocate with
      expectedAdmin = admin
      allocation
      requestedAt = demoTime
      inputHoldingCids
      extraArgs = emptyExtraArgs
  case result.output of
    AllocationInstructionResult_Completed allocationCid -> pure allocationCid
    _ -> fail "The demo registry did not complete the allocation"

atomicStandardTokenSwapTest : Script ()
atomicStandardTokenSwapTest = script do
  setTime demoTime
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  usdBank <- allocateParty "USD Bank"
  bondIssuer <- allocateParty "Bond Issuer"

  let usd = InstrumentId with admin = usdBank; id = "USD"
      bond = InstrumentId with admin = bondIssuer; id = "BOND-001"
      terms = SwapTerms with
        tradeId = "trade-001"
        offeredInstrument = usd
        offeredAmount = 1000.0
        requestedInstrument = bond
        requestedAmount = 5.0
        requestedAt = demoTime
        allocateBefore = allocationDeadline
        settleBefore = settlementDeadline

  usdRulesCid <- submit usdBank do
    createCmd DemoTokenRules with admin = usdBank; supportedInstrumentIds = ["USD"]; observers = [alice, bob]
  bondRulesCid <- submit bondIssuer do
    createCmd DemoTokenRules with admin = bondIssuer; supportedInstrumentIds = ["BOND-001"]; observers = [alice, bob]

  usdHolding <- submitMulti [usdBank, alice] [] do
    createCmd DemoHolding with admin = usdBank; owner = alice; instrumentId = usd; amount = 1200.0
  bondHolding <- submitMulti [bondIssuer, bob] [] do
    createCmd DemoHolding with admin = bondIssuer; owner = bob; instrumentId = bond; amount = 5.0
  let usdHoldingCid = toInterfaceContractId @Holding usdHolding
      bondHoldingCid = toInterfaceContractId @Holding bondHolding

  proposalCid <- submit alice do
    createCmd SwapProposal with proposer = alice; counterparty = bob; terms
  swapCid <- submit bob do
    exerciseCmd proposalCid Accept
  let tradeCid = coerceContractId proposalCid

  usdAllocationCid <- allocateLeg alice usdBank usdRulesCid
    (offeredAllocation alice bob tradeCid terms) [usdHoldingCid]
  bondAllocationCid <- allocateLeg bob bondIssuer bondRulesCid
    (requestedAllocation alice bob tradeCid terms) [bondHoldingCid]

  _ <- submit alice do
    exerciseCmd swapCid Settle with
      offeredAllocationCid = usdAllocationCid
      requestedAllocationCid = bondAllocationCid
      offeredExtraArgs = emptyExtraArgs
      requestedExtraArgs = emptyExtraArgs

  aliceUsd <- balance alice usd
  bobUsd <- balance bob usd
  aliceBond <- balance alice bond
  bobBond <- balance bob bond
  assertMsg "Alice should retain 200 USD change" (aliceUsd == 200.0)
  assertMsg "Bob should receive 1000 USD" (bobUsd == 1000.0)
  assertMsg "Alice should receive 5 bonds" (aliceBond == 5.0)
  assertMsg "Bob should have delivered all bonds" (bobBond == 0.0)

wrongAllocationMustRollBack : Script ()
wrongAllocationMustRollBack = script do
  setTime demoTime
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  issuer <- allocateParty "Issuer"

  let token = InstrumentId with admin = issuer; id = "TOKEN"
      terms = SwapTerms with
        tradeId = "trade-rollback"
        offeredInstrument = token
        offeredAmount = 10.0
        requestedInstrument = token
        requestedAmount = 20.0
        requestedAt = demoTime
        allocateBefore = allocationDeadline
        settleBefore = settlementDeadline

  rulesCid <- submit issuer do
    createCmd DemoTokenRules with admin = issuer; supportedInstrumentIds = ["TOKEN"]; observers = [alice, bob]
  aliceHoldingContract <- submitMulti [issuer, alice] [] do
    createCmd DemoHolding with admin = issuer; owner = alice; instrumentId = token; amount = 10.0
  bobHoldingContract <- submitMulti [issuer, bob] [] do
    createCmd DemoHolding with admin = issuer; owner = bob; instrumentId = token; amount = 20.0
  let aliceHolding = toInterfaceContractId @Holding aliceHoldingContract
      bobHolding = toInterfaceContractId @Holding bobHoldingContract

  proposalCid <- submit alice do
    createCmd SwapProposal with proposer = alice; counterparty = bob; terms
  swapCid <- submit bob $ exerciseCmd proposalCid Accept
  let tradeCid = coerceContractId proposalCid
  allocationA <- allocateLeg alice issuer rulesCid
    (offeredAllocation alice bob tradeCid terms) [aliceHolding]
  allocationB <- allocateLeg bob issuer rulesCid
    ((requestedAllocation alice bob tradeCid terms) with transferLegId = "wrong-leg") [bobHolding]

  submitMustFail alice do
    exerciseCmd swapCid Settle with
      offeredAllocationCid = allocationA
      requestedAllocationCid = allocationB
      offeredExtraArgs = emptyExtraArgs
      requestedExtraArgs = emptyExtraArgs

  -- The first transfer is rolled back together with the failed second leg.
  aliceBalance <- balance alice token
  bobBalance <- balance bob token
  assertMsg "Alice's allocation must remain locked after rollback" (aliceBalance == 10.0)
  assertMsg "Bob's allocation must remain locked after rollback" (bobBalance == 20.0)
